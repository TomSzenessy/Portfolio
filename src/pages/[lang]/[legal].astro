export function getStaticPaths() {
  const langs = ['en', 'de', 'es'];
  const legal = ['privacy-policy', 'terms-of-service', 'impressum'];
  return langs.flatMap((lang) => legal.map((page) => ({ params: { lang, legal: page } })));
}

const lang = (Astro.params.lang || 'en') as keyof typeof legalPages;
const legal = Astro.params.legal as keyof (typeof legalPages)['en'];
const t = useTranslations(lang as keyof typeof translations);
const langPages = legalPages[lang];
if (!langPages || !(legal in langPages)) {
  throw new Error('Invalid legal page route');
}
const page = langPages[legal];
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://szenessy.com').href;
---

<BaseLayout lang={lang} canonicalURL={canonicalURL} title={page.title} description={page.description}>
  <main class="relative z-10 w-full">
    <div class="container mx-auto px-6 max-w-4xl py-16">
      <h1 class="font-heading text-4xl md:text-5xl text-text-main mb-10">{page.heading}</h1>

      <div class="space-y-8 text-text-main/90">
        {page.sections.map((section) => (
          <section>
            <h2 class="font-heading text-2xl mb-3">{section.title}</h2>
            <div class="space-y-2 text-base leading-relaxed">
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="mt-12">
        <a href={`/${lang}/`} class="inline-block text-accent hover:underline decoration-2 underline-offset-4">
          ← {t('legal_back_home')}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
