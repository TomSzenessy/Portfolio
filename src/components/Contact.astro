---
import Icon from './Icon.astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section id="contact" class="mb-12 px-5 py-12 sm:px-6 md:mb-20 md:py-20">
    <div class="text-center mb-10 reveal-item md:mb-16">
        <h2 class="font-heading text-3xl text-text-main mb-4 transition-colors duration-300 md:text-4xl">
            {t('contact_title')}
        </h2>
        <p class="text-text-muted text-base max-w-2xl mx-auto transition-colors duration-300 md:text-lg">
            {t('contact_subtitle')}
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm">
            <span class="w-full font-semibold text-text-main sm:w-auto">{t('cv_download')}</span>
            <a href="/cv/Tom_Szenessy_CV_EN.pdf" download type="application/pdf" class="inline-flex min-h-[36px] items-center text-accent-text font-medium hover:underline decoration-2 underline-offset-4">{t('cv_english')} (PDF)</a>
            <span class="text-text-muted" aria-hidden="true">·</span>
            <a href="/cv/Tom_Szenessy_CV_DE.pdf" download type="application/pdf" class="inline-flex min-h-[36px] items-center text-accent-text font-medium hover:underline decoration-2 underline-offset-4">{t('cv_german')} (PDF)</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Direct Contact -->
        <div class="bg-card-bg rounded-3xl border border-border-main p-6 shadow-lg transition-all transition-colors duration-300 reveal-item text-center sm:p-8 md:p-10 md:text-left hover:shadow-xl">
            <div class="w-14 h-14 bg-accent/10 rounded-full flex items-center justify-center text-accent text-xl mb-6 mx-auto md:mx-0">
                <Icon name="paper-plane" />
            </div>
            <h3 class="font-heading text-2xl text-text-main mb-3 transition-colors duration-300">
                {t('contact_h2')}
            </h3>
            <p class="text-text-muted mb-8 transition-colors duration-300">
                {t('contact_p')}
            </p>
            <a href="mailto:tom@szenessy.com" class="inline-flex w-full items-center justify-center rounded-full bg-gradient-to-br from-accent to-orange-400 px-8 py-3.5 font-bold text-white shadow-lg shadow-accent/20 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/30 sm:w-auto">
                tom@szenessy.com
            </a>
            <div class="mt-6 pt-6 border-t border-border-main">
                <div class="flex justify-center md:justify-start gap-2 text-2xl text-text-muted">
                    <a href="https://www.youtube.com/@tomsze" target="_blank" rel="noopener" aria-label="Youtube" class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[#cc0000] hover:bg-accent/10 hover:scale-110 transition-all"><Icon name="youtube" /></a>
                    <a href="https://www.linkedin.com/in/tom-szenessy" target="_blank" rel="noopener" aria-label="Linkedin" class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[#0a58a8] hover:bg-accent/10 hover:scale-110 transition-all"><Icon name="linkedin" /></a>
                    <a href="https://github.com/TomSzenessy" target="_blank" rel="noopener" aria-label="Github" class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[#1f1f1f] hover:bg-accent/10 hover:scale-110 transition-all"><Icon name="github" /></a>
                    <a href="https://www.instagram.com/tom_szenessy/" target="_blank" rel="noopener" aria-label="Instagram" class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[#833ab4] hover:bg-accent/10 hover:scale-110 transition-all"><Icon name="instagram" /></a>
                </div>
            </div>
        </div>

        <!-- Topics Panel -->
        <div class="bg-card-bg rounded-3xl border border-border-main p-6 shadow-lg transition-all transition-colors duration-300 reveal-item sm:p-8 md:p-10 hover:shadow-xl" style="transition-delay: 100ms">
            <h3 class="font-heading text-2xl text-text-main mb-6 transition-colors duration-300">
                {t('contact_topics_title')}
            </h3>
            <ul class="space-y-4">
                <li class="flex gap-3 text-text-muted transition-colors duration-300">
                    <span class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0"></span>
                    <span>{t('contact_topic_1')}</span>
                </li>
                <li class="flex gap-3 text-text-muted transition-colors duration-300">
                    <span class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0"></span>
                    <span>{t('contact_topic_2')}</span>
                </li>
                <li class="flex gap-3 text-text-muted transition-colors duration-300">
                    <span class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0"></span>
                    <span>{t('contact_topic_3')}</span>
                </li>
            </ul>
            <p class="mt-8 text-text-muted italic opacity-80 border-t border-border-main pt-6 transition-colors duration-300">
                {t('contact_note')}
            </p>
        </div>
    </div>
</section>
