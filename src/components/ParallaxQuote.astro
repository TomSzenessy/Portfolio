---
import { Image, getImage } from 'astro:assets';
import mountainImage from '../assets/Fotos/Tom on Mountain-1600.webp';
import profileThumb from '../assets/Fotos/Tom Passfoto-400.webp';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const optimizedBg = await getImage({ src: mountainImage, format: 'webp' });
---

<!-- w-full (not w-screen): w-screen ignores the scrollbar and causes horizontal overflow -->
<div id="quotes" class="relative w-full h-[55vh] md:h-[60vh] bg-fixed bg-center bg-cover flex items-start p-6 mb-20 md:mb-24 overflow-hidden group"
     style={`background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.2)), url(${optimizedBg.src});`}>
    <div class="container mx-auto px-0 flex justify-center w-full">
        <div class="speech-bubble backdrop-blur p-6 md:p-8 rounded-3xl max-w-sm shadow-2xl transform transition-transform duration-700 hover:scale-105 reveal-item mt-14 md:mt-16">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-full border-4 border-white shadow-md overflow-hidden shrink-0">
                    <Image src={profileThumb} alt="Tom Szenessy" width={56} height={56} class="w-full h-full object-cover" />
                </div>
                <blockquote class="font-heading text-xl md:text-2xl text-text-main italic leading-tight">
                    {t('parallax_quote')}
                </blockquote>
            </div>
        </div>
    </div>
</div>