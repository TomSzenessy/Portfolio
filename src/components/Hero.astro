---
import { Image } from 'astro:assets';
import profileImage from '../assets/Fotos/Tom Passfoto-400.webp';
import Icon from './Icon.astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<header id="home" class="flex items-center justify-center py-16 md:py-20 mt-8">
    <div class="bg-card-bg/90 backdrop-blur-sm p-8 md:p-12 rounded-[40px] shadow-2xl border border-accent/10 text-center max-w-4xl w-full relative reveal-item active">
        <!-- Profile Image -->
        <div class="w-32 h-32 md:w-40 md:h-40 mx-auto -mt-28 md:-mt-32 mb-6 rounded-full border-8 border-white shadow-lg overflow-hidden relative z-10 bg-gradient-to-br from-accent to-orange-300">
            <Image
                src={profileImage}
                alt="Tom Szenessy"
                width={176}
                height={176}
                loading="eager"
                class="w-full h-full object-contain hover:scale-110 transition-transform duration-500"
            />
        </div>

        <div class="space-y-5">
            <!-- Warm eyebrow, deliberately small: the role is the headline -->
            <p class="text-accent font-bold tracking-widest uppercase text-sm" set:html={t('hero_greeting')} />

            <h1 class="font-heading text-2xl md:text-3xl lg:text-4xl text-text-main leading-tight" set:html={t('hero_h1')} />
            <p class="text-base md:text-lg text-text-main max-w-2xl mx-auto leading-relaxed font-medium" set:html={t('hero_subline')} />

            <!-- Stack keywords: surfaced above the fold for fast screening -->
            <div class="flex flex-wrap justify-center gap-2 pt-1">
                {['TypeScript', 'Python', 'Go', 'Cloudflare Workers', 'React', 'Node.js', 'Kotlin', 'PostgreSQL'].map(s => (
                    <span class="px-3 py-1.5 rounded-full bg-white/70 border border-accent/15 text-sm font-semibold text-text-muted">
                        {s}
                    </span>
                ))}
            </div>
            
            <p class="italic opacity-80 text-sm mt-1 block">
                {t('hero_note')}
            </p>

            <div class="flex flex-wrap justify-center gap-3 pt-2">
                <a href="#projects" class="group relative px-7 py-3.5 bg-gradient-to-r from-accent to-orange-400 text-white rounded-full font-semibold shadow-lg shadow-accent/30 hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-1 transition-all overflow-hidden">
                    <span class="relative z-10">{t('btn_see_work')}</span>
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                </a>
                <a href="#about" class="px-7 py-3.5 bg-transparent border-2 border-accent/40 text-text-main rounded-full font-semibold hover:bg-accent/10 hover:-translate-y-1 transition-all">
                    <span>{t('btn_more_about')}</span>
                </a>
            </div>

            <div class="flex flex-wrap justify-center gap-2 pt-3">
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="graduation-cap" class="text-accent" />
                    <span>{t('hero_badge_tum')}</span>
                </span>
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="location-dot" class="text-accent" />
                    <span>{t('hero_badge_location')}</span>
                </span>
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="heart" class="text-accent" />
                    <span>{t('hero_badge_focus')}</span>
                </span>
            </div>
        </div>


        <div class="mt-4 text-xs text-text-muted/40 italic hover:text-accent-text hover:opacity-100 transition-all cursor-default select-none">
            <span>{t('quote_mom_wake_up')}</span>
        </div>
    </div>
</header>
