---
import { Image } from 'astro:assets';
import profileImage from '../assets/Fotos/Tom Passfoto-square.webp';
import Icon from './Icon.astro';
import BgQuote from './BgQuote.astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<header id="home" class="relative flex items-center justify-center min-h-[calc(100svh-68px)] py-10 md:py-12">
    {/* the quote floats in the beige gutter beside the card, not inside it */}
    <BgQuote text={t('quote_mom_wake_up')} class="top-16 right-[calc(572px_-_50vw)]" />
    <div class="bg-card-bg/90 backdrop-blur-sm p-8 md:p-12 rounded-[40px] shadow-2xl border border-accent/10 text-center max-w-4xl w-full relative reveal-item active">
        <!-- Profile Image: aspect-true square asset on a soft brand backdrop,
             so the cut-out face no longer floats on white -->
        <div class="w-32 h-32 md:w-40 md:h-40 mx-auto -mt-10 sm:-mt-16 md:-mt-20 mb-6 rounded-full border-8 border-white bg-accent-soft shadow-lg overflow-hidden relative z-10">
            <Image
                src={profileImage}
                alt="Tom Szenessy"
                width={320}
                height={320}
                loading="eager"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
        </div>

        <div class="space-y-4">
            <!-- Name stays the headline: it is the thing a visitor looks for. -->
            <h1 class="font-heading text-4xl md:text-5xl text-text-main leading-tight" set:html={t('hero_greeting')} />

            <!-- One short line: what and where. The rest of the page carries the detail. -->
            <p class="text-lg md:text-xl text-text-main leading-relaxed">
                {t('hero_h1')}
                <span class="block text-base text-text-muted sm:inline sm:text-lg"><span class="hidden sm:inline">· </span>{t('hero_badge_focus')}</span>
            </p>

            <!-- The four channels, as one quiet, modern row. -->
            <div class="grid grid-cols-2 gap-y-0.5 pt-1 sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-7">
                <a href="https://www.youtube.com/@tomsze" target="_blank" rel="noopener" class="group inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-medium text-text-main transition-colors hover:text-accent-text hover:underline decoration-2 underline-offset-4 sm:justify-start">
                    <Icon name="youtube" class="text-base text-[#cc0000]" />
                    <span>YouTube</span>
                </a>
                <a href="https://www.linkedin.com/in/tom-szenessy" target="_blank" rel="noopener" class="group inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-medium text-text-main transition-colors hover:text-accent-text hover:underline decoration-2 underline-offset-4 sm:justify-start">
                    <Icon name="linkedin" class="text-base text-[#0a58a8]" />
                    <span>LinkedIn</span>
                </a>
                <a href="https://github.com/TomSzenessy" target="_blank" rel="noopener" class="group inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-medium text-text-main transition-colors hover:text-accent-text hover:underline decoration-2 underline-offset-4 sm:justify-start">
                    <Icon name="github" class="text-base text-[#1f1f1f]" />
                    <span>GitHub</span>
                </a>
                <a href="https://www.instagram.com/tom_szenessy/" target="_blank" rel="noopener" class="group inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-medium text-text-main transition-colors hover:text-accent-text hover:underline decoration-2 underline-offset-4 sm:justify-start">
                    <Icon name="instagram" class="text-base text-[#833ab4]" />
                    <span>Instagram</span>
                </a>
            </div>

            <div class="flex flex-wrap justify-center gap-3 pt-1">
                <a href="#projects" class="group relative px-7 py-3.5 bg-gradient-to-r from-accent to-orange-400 text-white rounded-full font-semibold shadow-lg shadow-accent/30 hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-1 transition-all overflow-hidden">
                    <span class="relative z-10">{t('btn_see_work')}</span>
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                </a>
                <a href="#contact" class="px-7 py-3.5 bg-transparent border-2 border-accent/40 text-text-main rounded-full font-semibold hover:bg-accent/10 hover:-translate-y-1 transition-all">
                    <span>{t('btn_more_about')}</span>
                </a>
            </div>
        </div>
    </div>
</header>
