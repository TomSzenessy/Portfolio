---
import { Image } from 'astro:assets';
import profileImage from '../assets/Fotos/Tom Passfoto-square.webp';
import Icon from './Icon.astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<header id="home" class="flex items-center justify-center py-14 md:py-16 mt-6">
    <div class="bg-card-bg/90 backdrop-blur-sm p-8 md:p-12 rounded-[40px] shadow-2xl border border-accent/10 text-center max-w-4xl w-full relative reveal-item active">
        <!-- Profile Image: aspect-true square asset on a soft brand backdrop,
             so the cut-out face no longer floats on white -->
        <div class="w-32 h-32 md:w-40 md:h-40 mx-auto -mt-28 md:-mt-32 mb-6 rounded-full border-8 border-white bg-accent-soft shadow-lg overflow-hidden relative z-10">
            <Image
                src={profileImage}
                alt="Tom Szenessy"
                width={176}
                height={176}
                loading="eager"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
        </div>

        <div class="space-y-5">
            <!-- Name stays the headline: it is the thing a visitor looks for. -->
            <h1 class="font-heading text-4xl md:text-5xl text-text-main leading-tight" set:html={t('hero_greeting')} />

            <!-- Positioning: what he is, in one line, bold lead-in. -->
            <p class="text-lg md:text-xl text-text-main max-w-2xl mx-auto leading-relaxed" set:html={t('hero_subline')} />

            <!-- Stack keywords as a single quiet line: greppable for recruiters,
                 but visually flat so it never competes with the headline. -->
            <p class="text-sm text-text-muted max-w-2xl mx-auto leading-relaxed">
                {t('hero_stack')}
            </p>

            <p class="italic opacity-80 text-sm block">
                {t('hero_note')}
            </p>

            <div class="flex flex-wrap justify-center gap-3 pt-1">
                <a href="#projects" class="group relative px-7 py-3.5 bg-gradient-to-r from-accent to-orange-400 text-white rounded-full font-semibold shadow-lg shadow-accent/30 hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-1 transition-all overflow-hidden">
                    <span class="relative z-10">{t('btn_see_work')}</span>
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                </a>
                <a href="#contact" class="px-7 py-3.5 bg-transparent border-2 border-accent/40 text-text-main rounded-full font-semibold hover:bg-accent/10 hover:-translate-y-1 transition-all">
                    <span>{t('btn_more_about')}</span>
                </a>
            </div>

            <div class="flex flex-wrap justify-center gap-2 pt-3">
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="trophy" class="text-accent-text" />
                    <span>{t('hero_badge_tum')}</span>
                </span>
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="graduation-cap" class="text-accent-text" />
                    <span>{t('hero_badge_location')}</span>
                </span>
                <span class="inline-flex items-center gap-2 px-3 py-1 bg-accent/10 rounded-full text-sm font-semibold text-text-main">
                    <Icon name="location-dot" class="text-accent-text" />
                    <span>{t('hero_badge_focus')}</span>
                </span>
            </div>
        </div>

        <div class="mt-5 text-xs text-text-muted italic hover:text-accent-text hover:opacity-100 transition-all cursor-default select-none">
            <span>{t('quote_mom_wake_up')}</span>
        </div>
    </div>
</header>
