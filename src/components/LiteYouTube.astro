---
interface Props {
  videoId: string;
  title: string;
  /** Duration badge text, e.g. "15:42". Hidden when missing. */
  duration?: string;
  /** Shown only if YouTube refuses to start playback (its bot gate). */
  stallText?: string;
  /** Label of the escape link inside that notice. */
  watchText?: string;
}

const { videoId, title, duration, stallText, watchText } = Astro.props;
---

<lite-youtube
    class="lite-youtube relative aspect-video cursor-pointer group rounded-xl overflow-hidden block bg-[#2d231c]"
    data-id={videoId}
    data-title={title}
    data-stall={stallText}
    data-watch={watchText}
>
    <!-- Local poster: stands in for the thumbnail until the visitor accepts
         third-party content. Deliberately NOT a YouTube URL, so nothing reaches
         Google before consent. The blurry background gives the card depth. -->
    <div class="yt-poster absolute inset-0 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-[#3d3028] to-[#241c16]"></div>
        <div class="absolute inset-0 opacity-25" aria-hidden="true" style="background-image:radial-gradient(circle at 30% 30%,#d07a3d,transparent 55%),radial-gradient(circle at 75% 70%,#8aa39a,transparent 55%)"></div>
    </div>

    <!-- Real thumbnail: injected only after the site-wide consent exists -->
    <img class="yt-thumb absolute inset-0 w-full h-full object-cover" alt="" aria-hidden="true" loading="lazy" />

    <!-- YouTube's own embed play button: red rounded rectangle, white triangle.
         Stays visible over the thumbnail, exactly like a real YouTube embed. -->
    <div class="yt-play absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[68px] h-[48px] bg-[#ff0000] rounded-[12px] flex items-center justify-center text-white shadow-lg group-hover:scale-110 group-hover:bg-[#ff0000] transition-transform duration-200">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v14l11-7-11-7z" />
            </svg>
        </div>
    </div>

    <!-- Duration badge (bottom-right), the way YouTube draws it -->
    {duration && (
        <span class="yt-duration absolute bottom-2 right-2 bg-black/80 text-white text-xs font-semibold px-1.5 py-0.5 rounded">
            {duration}
        </span>
    )}
</lite-youtube>

<script>
    /**
     * Consent model (site-wide, once):
     *   - On the FIRST visit the visitor gets one dialog explaining that
     *     accepting loads YouTube (Google) content under Google's terms.
     *   - Nothing is requested from Google before they accept.
     *   - Accepting stores a single flag in localStorage; from then on every
     *     video thumbnail loads and every video plays with no further prompt,
     *     including after a reload.
     *   - Declining stores the refusal: the site NEVER asks again and never
     *     loads Google content. Cards become quiet link-outs to youtube.com.
     *     A footer control lets the visitor change their mind later.
     */
    const CONSENT_KEY = 'yt-consent-v2';
    const ACCEPTED = 'accepted';
    const DECLINED = 'declined';

    /**
     * The player is the ordinary YouTube embed (www.youtube.com/embed) rather
     * than www.youtube-nocookie.com. The no-cookie domain is a separate
     * registrable domain, so it can never see the visitor's YouTube session —
     * a signed-in visitor is still an anonymous, cookieless client there,
     * which is exactly the state YouTube gates behind "Sign in to confirm
     * you're not a bot". The standard embed can at least see that session.
     *
     * No page-side change can switch that gate off: it is YouTube's own
     * server-side risk decision, driven by the visitor's network, cookies and
     * extensions. So the player is watched instead — if it never reaches a
     * playing state, the card offers a direct link to YouTube rather than
     * leaving the visitor stranded on YouTube's dead end.
     */
    const EMBED_BASE = 'https://www.youtube.com/embed/';

    /** Grace period before the "not playing" notice is offered. */
    const PLAYBACK_STALL_MS = 9000;

    class LiteYouTube extends HTMLElement {
        isValidVideoId = true;

        connectedCallback() {
            const videoId = this.dataset.id;
            this.isValidVideoId = Boolean(videoId && /^[a-zA-Z0-9_-]+$/.test(videoId));
            if (!this.isValidVideoId) {
                console.warn('Invalid YouTube video ID:', videoId);
                return;
            }

            this.addEventListener('click', (e) => {
                if ((e.target as HTMLElement).closest('a')) return;
                this.addIframe();
            });

            // Hovering only zooms the thumbnail (CSS). The player iframe is
            // created on the click itself and never in the background: a
            // hidden player that loads and is reloaded without a click is
            // both a privacy oddity and another signal YouTube's traffic
            // heuristics can read as automated.

            // React to consent given at any time on this page.
            document.addEventListener('yt-consent-change', () => this.syncThumb());
            this.syncThumb();
        }

        /**
         * `enablejsapi=1` is only used so the player reports its state back to
         * us; `origin` is required for that handshake and tells YouTube which
         * site is embedding the video.
         */
        embedSrc() {
            const params = new URLSearchParams({
                autoplay: '1',
                rel: '0',
                playsinline: '1',
                enablejsapi: '1'
            });
            if (/^https?:$/.test(window.location.protocol)) {
                params.set('origin', window.location.origin);
            }
            return `${EMBED_BASE}${this.dataset.id}?${params.toString()}`;
        }

        static readConsent(): string | null {
            try {
                return localStorage.getItem(CONSENT_KEY);
            } catch {
                return null;
            }
        }

        static setConsent(value: string | null) {
            try {
                if (value === null) localStorage.removeItem(CONSENT_KEY);
                else localStorage.setItem(CONSENT_KEY, value);
            } catch {
                /* storage blocked: fall back to per-session consent */
            }
            document.dispatchEvent(new CustomEvent('yt-consent-change'));
        }

        static hasConsent(): boolean {
            return LiteYouTube.readConsent() === ACCEPTED;
        }

        /** Show the real YouTube thumbnail once consent exists. */
        syncThumb() {
            if (!LiteYouTube.hasConsent()) return;
            const img = this.querySelector<HTMLImageElement>('.yt-thumb');
            const poster = this.querySelector('.yt-poster');
            if (!img) return;

            img.src = `https://i.ytimg.com/vi/${this.dataset.id}/maxresdefault.jpg`;
            img.addEventListener(
                'load',
                () => {
                    img.classList.add('is-loaded');
                    // Keep the red play button and duration badge visible —
                    // that is exactly how a real YouTube embed looks.
                    poster?.setAttribute('hidden', '');
                },
                { once: true }
            );
            // Some uploads lack a maxres asset; fall back to a smaller guaranteed size.
            img.addEventListener(
                'error',
                () => {
                    img.src = `https://i.ytimg.com/vi/${this.dataset.id}/hqdefault.jpg`;
                    img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
                },
                { once: true }
            );
        }

        async addIframe() {
            if (!this.isValidVideoId) return;

            const consent = LiteYouTube.readConsent();

            // An explicit refusal is final: never nag again, just link out.
            if (consent === DECLINED) {
                window.open(
                    `https://www.youtube.com/watch?v=${this.dataset.id}`,
                    '_blank',
                    'noopener'
                );
                return;
            }

            // No answer yet: run the one site-wide gate. Until it is answered
            // there is nothing to play, so do not fall through to an embed.
            if (consent !== ACCEPTED) {
                await ensureConsentDialog();
                if (!LiteYouTube.hasConsent()) return;
            }

            this.renderIframe();
        }

        renderIframe() {
            if (!this.isValidVideoId) return;

            this.dataset.played = 'true';
            this.classList.add('is-playing');

            const iframe = document.createElement('iframe');
            iframe.setAttribute('frameborder', '0');
            iframe.setAttribute('allowfullscreen', '1');
            iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
            // Hand YouTube this site's origin as the referrer, explicitly: the
            // browser default (strict-origin-when-cross-origin) already sends
            // it, but a stricter site-wide policy would break the embed's
            // domain check and produce YouTube's "Error 153" instead.
            iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
            iframe.setAttribute('title', this.dataset.title || 'YouTube Video');
            iframe.setAttribute('src', this.embedSrc());
            iframe.classList.add('w-full', 'h-full', 'absolute', 'inset-0');

            this.innerHTML = '';
            this.appendChild(iframe);
            this.watchPlayback(iframe);
        }

        /**
         * The embed can load perfectly and still never play: when YouTube's
         * bot gate takes over, the player stays in state -1 forever. Listen to
         * the player's own postMessage events and, if nothing ever plays,
         * offer the direct YouTube link.
         */
        watchPlayback(iframe: HTMLIFrameElement) {
            /**
             * Last state the player reported: -1 unstarted, 1 playing,
             * 2 paused, 3 buffering, 5 cued. A gated embed reports `3` for a
             * moment and then falls back to `-1` for good, so the decision is
             * made on the FINAL state, not on "did we ever see 3".
             */
            let lastState: number | null = null;

            const drop = () => {
                window.clearTimeout(timer);
                this.querySelector('.yt-stall')?.remove();
            };

            const onMessage = (e: MessageEvent) => {
                if (e.source !== iframe.contentWindow) return;
                if (!/^https:\/\/(www\.)?youtube(-nocookie)?\.com$/.test(e.origin)) return;

                let message: any;
                try {
                    message = JSON.parse(e.data);
                } catch {
                    return;
                }
                const state = message?.info?.playerState;
                if (typeof state !== 'number') return;
                lastState = state;
                // Really playing: the notice is unnecessary, now or later.
                if (state === 1) drop();
            };

            const timer = window.setTimeout(() => {
                // -1 unstarted and 3 buffering mean nothing is playing. A
                // paused (2), cued (5) or playing (1) player is fine, and no
                // report at all means the API is blocked — do not guess then.
                if (lastState === -1 || lastState === 3) this.showStallNotice();
            }, PLAYBACK_STALL_MS);

            window.addEventListener('message', onMessage);

            // The player only starts posting events after this handshake.
            iframe.addEventListener(
                'load',
                () => {
                    iframe.contentWindow?.postMessage(
                        JSON.stringify({ event: 'listening', id: this.dataset.id }),
                        '*'
                    );
                },
                { once: true }
            );
        }

        /** A slim, dismissible bar over the bottom of the player. */
        showStallNotice() {
            if (!this.isValidVideoId || this.querySelector('.yt-stall')) return;

            const bar = document.createElement('div');
            bar.className =
                'yt-stall absolute inset-x-0 bottom-0 z-[2] flex flex-wrap items-center gap-x-3 gap-y-2 bg-black/85 px-4 py-3 text-white';
            bar.setAttribute('role', 'status');

            const text = document.createElement('p');
            text.className = 'm-0 min-w-[11rem] flex-1 text-[13px] leading-snug';
            text.textContent = this.dataset.stall || 'This video is not starting.';

            const link = document.createElement('a');
            link.href = `https://www.youtube.com/watch?v=${this.dataset.id}`;
            link.target = '_blank';
            link.rel = 'noopener';
            link.className =
                'shrink-0 rounded-full bg-white px-3 py-1.5 text-[13px] font-semibold text-black no-underline hover:bg-white/90';
            link.textContent = this.dataset.watch || 'Watch on YouTube';

            const close = document.createElement('button');
            close.type = 'button';
            close.setAttribute('aria-label', 'Dismiss');
            close.className = 'shrink-0 px-1 text-lg leading-none text-white/70 hover:text-white';
            close.textContent = '×';
            close.addEventListener('click', () => bar.remove());

            bar.append(text, link, close);
            this.appendChild(bar);
        }
    }

    if (!customElements.get('lite-youtube')) {
        customElements.define('lite-youtube', LiteYouTube);
    }

    /* ------------------------------------------------------------------ */
    /* The single site-wide consent dialog                                  */
    /* ------------------------------------------------------------------ */
    let dialogPromise: Promise<void> | null = null;

    /** Localized dialog copy — the site is EN/DE/ES (see html[lang]). */
    function consentCopy() {
        const lang = document.documentElement.lang?.slice(0, 2) || 'en';
        const copy = {
            de: {
                title: 'YouTube-Videos laden?',
                body: 'Die Videos stammen von YouTube, einem Dienst von Google. Beim Laden werden deine IP-Adresse und Browserdaten an Google übertragen, die Google eigene Zwecken nutzen darf — auch für personalisierte Werbung. Das geschieht unter Googles Nutzungsbedingungen und Datenschutzerklärung, auf die ich keinen Einfluss habe.',
                detail: 'Es wird nichts von YouTube oder Google geladen, bevor du dich entscheidest. Wenn du zustimmst, merke ich mir die Wahl auf diesem Gerät und die Videos laufen ab sofort direkt. Wenn du ablehnst, kannst du sie weiterhin direkt auf YouTube ansehen.',
                accept: 'Akzeptieren und Videos laden',
                decline: 'Nein, danke',
                link: 'Google Datenschutzerklärung',
            },
            es: {
                title: '¿Cargar vídeos de YouTube?',
                body: 'Los vídeos proceden de YouTube, un servicio de Google. Al cargarlos se envían tu dirección IP y datos de navegación a Google, que puede usarlos para sus propios fines, incluida la publicidad personalizada. Esto ocurre bajo los Términos y la Política de Privacidad de Google, que no controlo.',
                detail: 'No se carga nada de YouTube ni de Google hasta que tú decidas. Si aceptas, recuerdo la decisión en este dispositivo y los vídeos se reproducirán directamente a partir de ahora. Si rechazas, puedes verlos directamente en YouTube.',
                accept: 'Aceptar y cargar vídeos',
                decline: 'No, gracias',
                link: 'Política de Privacidad de Google',
            },
            en: {
                title: 'Load YouTube videos?',
                body: 'The videos below are hosted on YouTube, a service provided by Google. Loading them sends your IP address and browsing data to Google, which may use it for its own purposes, including personalised advertising. This happens under Google’s Terms of Service and Privacy Policy, which I do not control.',
                detail: 'Nothing is loaded from YouTube or Google until you choose. If you accept, I remember that choice on this device and the videos will play straight away from now on. If you decline, you can still watch them on YouTube itself.',
                accept: 'Accept and load videos',
                decline: 'No thanks',
                link: 'Google Privacy Policy',
            },
        } as const;
        return copy[lang as keyof typeof copy] ?? copy.en;
    }

    function ensureConsentDialog(): Promise<void> {
        if (dialogPromise) return dialogPromise;

        dialogPromise = new Promise<void>((resolve) => {
            const copy = consentCopy();

            const overlay = document.createElement('div');
            overlay.className = 'yt-consent-overlay fixed inset-0 z-[9999] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto';

            const dialog = document.createElement('div');
            dialog.setAttribute('role', 'dialog');
            dialog.setAttribute('aria-modal', 'true');
            dialog.setAttribute('aria-labelledby', 'yt-consent-title');
            dialog.className = 'yt-consent-dialog max-w-lg w-full rounded-3xl bg-card-bg border border-accent/20 p-7 md:p-8 text-text-main shadow-2xl my-auto';

            const heading = document.createElement('h3');
            heading.id = 'yt-consent-title';
            heading.className = 'font-heading text-2xl md:text-3xl mb-3';
            heading.textContent = copy.title;

            const para = document.createElement('p');
            para.className = 'text-[15px] leading-relaxed text-text-main/90 mb-3';
            para.textContent = copy.body;

            const para2 = document.createElement('p');
            para2.className = 'text-sm leading-relaxed text-text-muted mb-6';
            para2.textContent = copy.detail;

            const policy = document.createElement('a');
            policy.href = 'https://policies.google.com/privacy';
            policy.target = '_blank';
            policy.rel = 'noopener noreferrer';
            policy.className = 'text-accent-text font-medium underline underline-offset-2 hover:opacity-80 inline-block mb-6';
            policy.textContent = copy.link;

            const actions = document.createElement('div');
            actions.className = 'flex flex-col-reverse sm:flex-row gap-3 sm:justify-end';

            const declineBtn = document.createElement('button');
            declineBtn.type = 'button';
            declineBtn.className = 'yt-consent-decline px-5 py-3 rounded-full border border-text-muted/40 text-text-main font-medium hover:bg-text-main/5 transition-colors';
            declineBtn.textContent = copy.decline;

            const acceptBtn = document.createElement('button');
            acceptBtn.type = 'button';
            acceptBtn.className = 'yt-consent-accept px-5 py-3 rounded-full bg-accent text-white font-semibold hover:bg-orange-400 transition-colors';
            acceptBtn.textContent = copy.accept;

            actions.appendChild(declineBtn);
            actions.appendChild(acceptBtn);

            dialog.append(heading, para, para2, policy, actions);
            overlay.appendChild(dialog);
            document.body.appendChild(overlay);

            const previousOverflow = document.body.style.overflow;
            document.body.style.overflow = 'hidden';

            const finish = (value: string) => {
                // Detach the key handler here: the DOM has no 'remove' event,
                // so the old `overlay.addEventListener('remove', …)` never
                // fired and a leaked Escape handler later flipped consent.
                document.removeEventListener('keydown', onKey);
                LiteYouTube.setConsent(value);
                overlay.remove();
                document.body.style.overflow = previousOverflow;
                dialogPromise = null;
                resolve();
            };

            declineBtn.addEventListener('click', () => finish(DECLINED));
            acceptBtn.addEventListener('click', () => finish(ACCEPTED));
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) finish(DECLINED);
            });

            // Keep focus inside the dialog and let Escape count as "decline"
            // so dismissing never silently records consent.
            const onKey = (e: KeyboardEvent) => {
                if (e.key === 'Escape') {
                    finish(DECLINED);
                    return;
                }
                if (e.key !== 'Tab') return;
                const focusable = dialog.querySelectorAll<HTMLElement>('button, a[href]');
                if (!focusable.length) return;
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault();
                    first.focus();
                }
            };
            document.addEventListener('keydown', onKey);
            acceptBtn.focus();
        });

        return dialogPromise;
    }

    /**
     * Ask once per device, on the first visit, as soon as the page is idle —
     * not on the first click, which interrupts the visitor mid-scroll.
     * Only offered if there is at least one video on the page.
     */
    function initConsentGate() {
        if (LiteYouTube.readConsent()) return;
        if (!document.querySelector('lite-youtube')) return;

        const open = () => ensureConsentDialog();
        if ('requestIdleCallback' in window) {
            (window as any).requestIdleCallback(open, { timeout: 2500 });
        } else {
            window.setTimeout(open, 1200);
        }
    }

    /* Withdrawal of consent (GDPR Art. 7(3)): the footer control calls this. */
    (window as any).__ytConsentReset = () => {
        LiteYouTube.setConsent(null);
        document.querySelectorAll('lite-youtube').forEach((el) => {
            const img = el.querySelector<HTMLImageElement>('.yt-thumb');
            const poster = el.querySelector('.yt-poster');
            if (img) {
                img.removeAttribute('src');
                img.classList.remove('is-loaded');
            }
            poster?.removeAttribute('hidden');
            el.querySelector('.yt-stall')?.remove();
        });
        ensureConsentDialog();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initConsentGate);
    } else {
        initConsentGate();
    }
</script>

<style>
    .lite-youtube iframe {
        border-radius: inherit;
    }

    /* Facade chrome sits ABOVE the preloaded (hidden, autoplay-off) player,
       so nothing of it shows before the visitor actually clicks. */
    .lite-youtube .yt-poster,
    .lite-youtube .yt-thumb,
    .lite-youtube .yt-play,
    .lite-youtube .yt-duration {
        z-index: 1;
    }
    /* Hover affordance: gentle zoom only — playback never starts on hover. */
    .lite-youtube .yt-thumb {
        transition: transform 0.4s ease;
    }
    .lite-youtube:hover .yt-thumb {
        transform: scale(1.03);
    }
    /* Once the real player is up, all facade chrome is gone. */
    .lite-youtube.is-playing .yt-thumb,
    .lite-youtube.is-playing .yt-play,
    .lite-youtube.is-playing .yt-duration,
    .lite-youtube.is-playing .yt-poster {
        visibility: hidden;
    }
    /* Touch devices: keep the play affordance obvious. */
    @media (hover: none) {
        .lite-youtube .yt-play {
            opacity: 1;
        }
    }
</style>
