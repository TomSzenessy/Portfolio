---
interface Props {
  videoId: string;
  title: string;
  consentTitle: string;
  consentBody: string;
  consentAccept: string;
  consentCancel: string;
}

const { videoId, title, consentTitle, consentBody, consentAccept, consentCancel } = Astro.props;
---

<lite-youtube
    class="lite-youtube relative aspect-video cursor-pointer group rounded-xl overflow-hidden shadow-lg block bg-[#2d231c]"
    data-id={videoId}
    data-title={title}
    data-consent-title={consentTitle}
    data-consent-body={consentBody}
    data-consent-accept={consentAccept}
    data-consent-cancel={consentCancel}
>
    <!-- Local poster: shown until the visitor grants third-party consent.
         Deliberately NOT a YouTube URL, so nothing reaches Google early. -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center bg-gradient-to-br from-[#3d3028] to-[#241c16]">
        <div class="w-14 h-14 rounded-full bg-accent flex items-center justify-center text-white shadow-xl group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v14l11-7-11-7z" />
            </svg>
        </div>
        <span class="text-white/70 text-xs font-semibold tracking-wide">YouTube</span>
    </div>

    <!-- Real thumbnail: injected only after consent -->
    <img class="yt-thumb absolute inset-0 w-full h-full object-cover" alt="" aria-hidden="true" loading="lazy" />

    <!-- Play Button Overlay -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center text-white text-2xl shadow-xl group-hover:scale-110 group-hover:bg-orange-400 transition-all duration-300">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v14l11-7-11-7z" />
            </svg>
        </div>
    </div>
</lite-youtube>

<script>
    class LiteYouTube extends HTMLElement {
        static consentStorageKey = 'youtube-consent-granted';
        static consentDialogPromise = null;
        isValidVideoId = true;

        constructor() {
            super();
        }

        connectedCallback() {
            const videoId = this.dataset.id;
            this.isValidVideoId = Boolean(videoId && /^[a-zA-Z0-9_-]+$/.test(videoId));
            if (!this.isValidVideoId) {
                console.warn('Invalid YouTube video ID:', videoId);
                return;
            }
            this.addEventListener('click', () => this.addIframe());
            this.syncThumb();
        }

        hasConsent() {
            return localStorage.getItem(LiteYouTube.consentStorageKey) === 'true';
        }

        /** Show the real YouTube thumbnail once consent exists (and refresh it if consent was granted later). */
        syncThumb() {
            if (!this.hasConsent()) return;
            const img = this.querySelector<HTMLImageElement>('.yt-thumb');
            if (!img) return;
            img.src = `https://i.ytimg.com/vi/${this.dataset.id}/maxresdefault.jpg`;
            img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
            // Some uploads lack a maxres asset; fall back to a guaranteed smaller size.
            img.addEventListener('error', () => {
                img.src = `https://i.ytimg.com/vi/${this.dataset.id}/hqdefault.jpg`;
                img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
            }, { once: true });
        }

        async addIframe() {
            if (!this.isValidVideoId) return;
            if (!this.hasConsent()) {
                const granted = await this.requestConsent();
                if (!granted) return;
                localStorage.setItem(LiteYouTube.consentStorageKey, 'true');
            }

            this.renderIframe();
        }

        renderIframe() {
            if (!this.isValidVideoId) return;
            const videoId = this.dataset.id;
            const title = this.dataset.title;
            const iframe = document.createElement('iframe');

            iframe.setAttribute('frameborder', '0');
            iframe.setAttribute('allowfullscreen', '1');
            iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
            iframe.setAttribute('title', title || 'YouTube Video');
            iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`);
            iframe.classList.add('w-full', 'h-full', 'absolute', 'inset-0');

            this.innerHTML = '';
            this.appendChild(iframe);
        }

        requestConsent() {
            if (LiteYouTube.consentDialogPromise) {
                return LiteYouTube.consentDialogPromise;
            }

            const title = this.dataset.consentTitle || 'Load YouTube?';
            const body = this.dataset.consentBody || 'By playing this video, a connection to YouTube will be established.';
            const acceptLabel = this.dataset.consentAccept || 'Allow YouTube';
            const cancelLabel = this.dataset.consentCancel || 'Cancel';

            LiteYouTube.consentDialogPromise = new Promise((resolve) => {
                const overlay = document.createElement('div');
                overlay.className = 'yt-consent-overlay fixed inset-0 z-[9999] bg-black/70 flex items-center justify-center p-4';

                const dialog = document.createElement('div');
                dialog.className = 'yt-consent-dialog max-w-md w-full rounded-2xl bg-card-bg border border-white/10 p-6 text-text-main shadow-2xl';

                const heading = document.createElement('h3');
                heading.className = 'font-heading text-2xl mb-3';
                heading.textContent = title;

                const paragraph = document.createElement('p');
                paragraph.className = 'text-sm text-text-muted mb-6';
                paragraph.textContent = body;

                const actions = document.createElement('div');
                actions.className = 'flex gap-3 justify-end';

                const cancelBtn = document.createElement('button');
                cancelBtn.type = 'button';
                cancelBtn.className = 'yt-consent-cancel px-4 py-2 rounded-lg border border-white/20 text-sm hover:border-white/40 transition-colors';
                cancelBtn.textContent = cancelLabel;

                const acceptBtn = document.createElement('button');
                acceptBtn.type = 'button';
                acceptBtn.className = 'yt-consent-accept px-4 py-2 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-orange-400 transition-colors';
                acceptBtn.textContent = acceptLabel;

                actions.appendChild(cancelBtn);
                actions.appendChild(acceptBtn);
                dialog.appendChild(heading);
                dialog.appendChild(paragraph);
                dialog.appendChild(actions);

                overlay.appendChild(dialog);
                document.body.appendChild(overlay);

                const cleanup = (value) => {
                    overlay.remove();
                    LiteYouTube.consentDialogPromise = null;
                    resolve(value);
                };

                dialog.querySelector('.yt-consent-cancel').addEventListener('click', () => cleanup(false));
                dialog.querySelector('.yt-consent-accept').addEventListener('click', () => cleanup(true));
                overlay.addEventListener('click', (event) => {
                    if (event.target === overlay) cleanup(false);
                });
            });

            return LiteYouTube.consentDialogPromise;
        }
    }

    if (!customElements.get('lite-youtube')) {
        customElements.define('lite-youtube', LiteYouTube);
    }
</script>

<style>
    .lite-youtube iframe {
        border-radius: inherit;
    }
</style>