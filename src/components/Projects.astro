---
import LiteYouTube from './LiteYouTube.astro';
import Icon from './Icon.astro';
import videos from '../data/videos.json';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const SHOW = 4;
const topVideos = (videos as any[]).slice(0, SHOW);

// Page locale for number/date formatting (site serves /en /de /es).
const localeTag =
    (Astro.url.pathname.match(/^\/(de|es)(\/|$)/) || [])[1] === 'de' ? 'de-DE'
    : (Astro.url.pathname.match(/^\/(de|es)(\/|$)/) || [])[1] === 'es' ? 'es-ES'
    : 'en-US';

const formatViews = (n: number) =>
    new Intl.NumberFormat(localeTag, { notation: 'compact', maximumFractionDigits: 1 }).format(n);

const formatAge = (iso: string) => {
    const days = Math.round((Date.now() - new Date(iso).getTime()) / 86400000);
    const rtf = new Intl.RelativeTimeFormat(localeTag, { numeric: 'auto' });
    // Floor like YouTube does: "1 month ago" until 60 days, not 45.
    if (days < 30) return rtf.format(-days, 'day');
    if (days < 365) return rtf.format(-Math.floor(days / 30), 'month');
    return rtf.format(-Math.floor(days / 365), 'year');
};

// The Agentic Trading Bot card links to a repo that is not public yet —
// hidden until the sanitized repo ships (its GitHub URL currently 404s).
const SHOW_TRADING_BOT = false;

const projects = [
  {
    id: 'roadtax',
    kicker: t('proj_roadtax_kicker'),
    title: t('proj_roadtax_title'),
    desc: t('proj_roadtax_desc'),
    tags: ['TypeScript', 'Cloudflare Workers', 'Multiplayer'],
    href: 'https://roadtax.app/',
    cta: t('proj_play'),
    icon: 'globe'
  },
  {
    id: 'mindmap',
    kicker: t('proj_mindmap_kicker'),
    title: t('proj_mindmap_title'),
    desc: t('proj_mindmap_desc'),
    tags: ['JavaScript', 'Obsidian', 'Mobile'],
    href: 'https://github.com/TomSzenessy/Mindmap-Plugin-for-Obsidian',
    cta: t('proj_view'),
    icon: 'code'
  },
  {
    id: 'sidestroll',
    kicker: t('proj_sidestroll_kicker'),
    title: t('proj_sidestroll_title'),
    desc: t('proj_sidestroll_desc'),
    tags: ['TypeScript', 'AI', 'Team of 5'],
    href: 'https://sidestroll.com/',
    cta: t('proj_view'),
    icon: 'users'
  },
  {
    id: 'mino',
    kicker: t('proj_mino_kicker'),
    title: t('proj_mino_title'),
    desc: t('proj_mino_desc'),
    tags: ['TypeScript', 'AI', 'Vector DB'],
    href: 'https://mino.ink/',
    cta: t('proj_view'),
    icon: 'robot'
  },
  {
    id: 'bot',
    kicker: t('proj_bot_kicker'),
    title: t('proj_bot_title'),
    desc: t('proj_bot_desc'),
    tags: ['Python', 'Alpaca', 'LLM'],
    href: 'https://github.com/TomSzenessy/AlpacaTradingBot',
    cta: t('proj_view'),
    icon: 'code'
  },
  {
    id: 'worldfolder',
    kicker: t('proj_worldfolder_kicker'),
    title: t('proj_worldfolder_title'),
    desc: t('proj_worldfolder_desc'),
    tags: ['Go', 'Kubernetes', 'Self-hosted'],
    href: 'https://worldfolder.com/',
    cta: t('proj_view'),
    icon: 'globe'
  }
];

// JSON-LD for the videos actually shown (description + thumbnailUrl are
// required for Google video rich results)
const videoStructuredData = topVideos.map(v => ({
  "@type": "VideoObject",
  "name": v.title,
  "description": `${v.title} — a video by Tom Szenessy.`,
  "thumbnailUrl": `https://i.ytimg.com/vi/${v.embedId}/maxresdefault.jpg`,
  "uploadDate": v.published,
  "contentUrl": v.watchUrl,
  "embedUrl": `https://www.youtube.com/embed/${v.embedId}`
}));

const visibleProjects = projects.filter(p => SHOW_TRADING_BOT || p.id !== 'bot');
---

<section id="projects" class="py-20 scroll-mt-24">
    <div class="text-center mb-16 reveal-item">
        <p class="text-accent font-bold tracking-widest uppercase text-xs mb-3">
            {t('projects_kicker')}
        </p>
        <h2 class="font-heading text-4xl md:text-5xl text-text-main mb-4">
            {t('projects_title')}
        </h2>
        <p class="text-text-muted text-lg max-w-2xl mx-auto">
            {t('projects_subtitle')}
        </p>
    </div>

    <!-- Videos: ranked by view count, fetched at build time. The card copies
         YouTube's own embed anatomy: red play button + duration badge on the
         thumbnail, channel/title/views row beneath. -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-24">
        {topVideos.map((v, i) => (
            <div class="bg-card-bg rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 reveal-item group" style={`transition-delay: ${i % 2 === 0 ? 0 : 100}ms`}>
                <LiteYouTube
                    videoId={v.embedId}
                    title={v.title}
                    duration={v.duration}
                />
                <div class="flex items-start gap-3 p-4">
                    <div class="w-9 h-9 shrink-0 rounded-full bg-accent/15 flex items-center justify-center text-accent-text font-bold text-sm">
                        T
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-semibold text-[15px] leading-snug text-text-main line-clamp-2 group-hover:text-accent-text transition-colors">
                            {v.title}
                        </h3>
                        <p class="text-[13px] text-text-muted mt-1">
                            Tom Szenessy
                            {v.views != null && <> · {formatViews(v.views)}&nbsp;{t('video_views')}</>}
                            {v.published && <> · {formatAge(v.published)}</>}
                        </p>
                    </div>
                    <a
                        href={v.watchUrl}
                        target="_blank"
                        rel="noopener"
                        class="shrink-0 inline-flex items-center text-[13px] text-accent-text font-semibold hover:underline underline-offset-2"
                    >
                        <span>{t('video_watch')}</span>
                        <Icon name="arrow-right" class="ml-1 text-xs transition-transform group-hover:translate-x-1" />
                    </a>
                </div>
            </div>
        ))}
    </div>

    <!-- Projects -->
    <div class="flex items-center gap-4 mb-10 reveal-item">
        <h3 class="font-heading text-3xl text-text-main">{t('projects_built_title')}</h3>
        <div class="flex-1 h-px bg-border-main"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {visibleProjects.map((p, i) => (
            <a
                href={p.href}
                target="_blank"
                rel="noopener"
                class="bg-card-bg rounded-3xl p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 reveal-item group border border-border-main"
                style={`transition-delay: ${i % 2 === 0 ? 0 : 80}ms`}
            >
                <div class="flex items-start gap-4">
                    <div class="w-11 h-11 shrink-0 rounded-xl bg-accent/10 flex items-center justify-center text-accent text-xl">
                        <Icon name={p.icon} />
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-accent uppercase tracking-wider mb-1.5">
                            {p.kicker}
                        </p>
                        <h4 class="font-heading text-xl text-text-main mb-2 group-hover:text-accent-text transition-colors">
                            {p.title}
                        </h4>
                        <p class="text-sm text-text-muted mb-3">
                            {p.desc}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            {p.tags.map(tag => (
                                <span class="px-2 py-0.5 rounded-full bg-accent/10 text-[13px] font-semibold text-text-main">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            </a>
        ))}
    </div>

    <div class="mt-10 text-center reveal-item">
        <a href="https://github.com/TomSzenessy" target="_blank" rel="noopener" class="inline-flex items-center gap-2 py-2.5 px-4 text-accent-text font-semibold hover:underline decoration-2 underline-offset-4">
            <Icon name="github" />
            <span>{t('projects_more_github')}</span>
        </a>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": videoStructuredData
})} />