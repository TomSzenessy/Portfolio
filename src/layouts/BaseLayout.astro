---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalURL?: string;
}

const { 
  title = "Tom Szenessy — Business Informatics @ TUM | Projects & Videos",
  description = "Tom Szenessy is a Business Informatics student at TU Munich who builds and ships full-stack products — games, plugins and self-hosted platforms. Projects, awards and videos.",
  lang = "en",
  canonicalURL
} = Astro.props;

const siteURL = "https://szenessy.com";
const ogImage = `${siteURL}/og-image.png`;

// Language alternates for hreflang: derive the same path in each language.
const rest = Astro.url.pathname.replace(/^\/(en|de|es)(?=\/|$)/, '') || '/';
const altUrls = {
  en: `${siteURL}/en${rest}`,
  de: `${siteURL}/de${rest}`,
  es: `${siteURL}/es${rest}`
};

// JSON-LD Structured Data — every fact here also exists as visible prose
// (LLMs read text, not JSON-LD), and every claim links to third-party proof.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteURL}/#person`,
  "name": "Tom Szenessy",
  "url": siteURL,
  "image": ogImage,
  "jobTitle": "Business Informatics Student",
  "affiliation": {
    "@type": "Organization",
    "name": "Technical University of Munich"
  },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "Technical University of Munich" },
    { "@type": "EducationalOrganization", "name": "Deutsche Schule Málaga" }
  ],
  "knowsAbout": [
    "TypeScript", "Python", "Go", "Kotlin", "React", "Node.js",
    "Kubernetes", "Cloudflare", "PostgreSQL", "Machine Learning",
    "Full-Stack Development", "Self-Hosting"
  ],
  "sameAs": [
    "https://github.com/TomSzenessy",
    "https://www.linkedin.com/in/tom-szenessy",
    "https://www.youtube.com/@tomsze"
  ]
};

import '../styles/global.css';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        
        <!-- Favicon: face in a cream rounded-square tile. favicon.ico first for
             the classic /favicon.ico probe; favicon-v2.webp is cache-busted so
             browsers drop the old squished icon. -->
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" type="image/webp" href="/favicon-v2.webp" sizes="any" />
        <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
        <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#f6eee2" />
        
        <!-- Canonical URL -->
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}

        <!-- Language alternates (EN/DE/ES) -->
        <link rel="alternate" hreflang="en" href={altUrls.en} />
        <link rel="alternate" hreflang="de" href={altUrls.de} />
        <link rel="alternate" hreflang="es" href={altUrls.es} />
        <link rel="alternate" hreflang="x-default" href={altUrls.en} />
        
        <!-- Open Graph -->
        <meta property="og:site_name" content="Tom Szenessy" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:image" content={ogImage} />
        
        <!-- Twitter Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        
        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    </head>
    <body class="bg-bg text-text-main font-body selection:bg-accent selection:text-white overflow-x-hidden">
        <!-- Background Canvas for Particles -->
        <canvas id="bg-canvas" class="fixed top-0 left-0 w-full h-full z-0 opacity-40 pointer-events-none"></canvas>

        <!-- Noise Overlay -->
        <div class="noise-bg"></div>

        <slot />
    </body>
</html>
