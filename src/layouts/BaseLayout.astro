---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalURL?: string;
}

const { 
  title = "Tom Szenessy | Just a chill, friendly Business Informatics Student",
  description = "Tom Szenessy is a friendly Business Informatics student at TUM in Munich, building creative projects with AI, VR, and product design.",
  lang = "en",
  canonicalURL
} = Astro.props;

const siteURL = "https://szenessy.com";
const ogImage = `${siteURL}/og-image.png`;

// JSON-LD Structured Data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Tom Szenessy",
  "url": siteURL,
  "jobTitle": "Business Informatics Student",
  "affiliation": {
    "@type": "Organization",
    "name": "Technical University of Munich"
  },
  "sameAs": [
    "https://github.com/TomSzenessy",
    "https://www.linkedin.com/in/tom-szenessy-ab34a6276",
    "https://www.youtube.com/@tomsze"
  ]
};

import '../styles/global.css';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        
        <!-- Favicon: square 512 master, downscaled by the browser -->
        <link rel="icon" type="image/webp" href="/favicon.webp" sizes="any" />
        <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
        <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#f6eee2" />
        
        <!-- Canonical URL -->
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}
        
        <!-- Open Graph -->
        <meta property="og:site_name" content="Tom Szenessy" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:image" content={ogImage} />
        
        <!-- Twitter Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        
        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    </head>
    <body class="bg-bg text-text-main font-body selection:bg-accent selection:text-white overflow-x-hidden">
        <!-- Background Canvas for Particles -->
        <canvas id="bg-canvas" class="fixed top-0 left-0 w-full h-full z-0 opacity-40 pointer-events-none"></canvas>

        <!-- Noise Overlay -->
        <div class="noise-bg"></div>

        <slot />
    </body>
</html>
